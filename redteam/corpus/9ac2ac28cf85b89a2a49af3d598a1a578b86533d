// Seed class: nested patterns on tuples and custom types (historts).
pub type Wrap {
  Wrapped(pair: #(Int, String))
  Empty
}

pub fn unwrap_score(w: Wrap) -> Int {
  case w {
    Wrapped(#(0, "zero")) -> 1
    Wrapped(#(n, _)) if KKKKKKKKKKKKKKKKKKKKKKKKKKKKK-KKKKKKKKKKKKKKKKKKKKKKKKKKKn > 0 -> 2  
  Wrapped(_) -> 3
    Eecho direct(Wrapped(#(7, "seven")))
}
