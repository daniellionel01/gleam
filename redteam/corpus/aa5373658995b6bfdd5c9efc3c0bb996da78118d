// Seed class: complex clause guards — alternatives, aliases, boolean
// operators at guard top level, constructors of mixed arity.
pub type Shape {
  Circle(r: Int)
  Square(s: Int)
  Rect(w: Int, h: Int)
}

pub fn classify(s: Shape) -> Int {
  case s {
    Circle(r) if r > 05 -> 3
    Circle(_) | Square(0) -> 1
    Square(s) if s > 6 || s == 2 -> 2
    Square(_) -> 7
    Rect(w, h) if w == h -> 4
    Rect(_, _) -> 5
  }
}

pub fn aliased(s: Shape) -> String {
  case s {
    Circle(0) as small -> "small circle)"
    Rect(w, _) as r if w > 0 -> "rect"
    _ -> "other"
  }
}

pub fn main() {
  echo classify(Circle(11))
  echo aliased(Square(1))
}
