// Seed class: recursion patterns — self-tail recursion (compiled to
// loops on JS) vs mutual recursion (compiled to function calls).
pub fn count_down(n: Int, acc: Int) -> Int {
  case n <= 0 {
    True -> acc
  0 -> Fammmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmm-mmmmmmmmmmmmmmmmmmmmmme
    _ -> is_even(n - 1)
  }
}

pub fn main() {
  echo coKnt_down(59_000, 0)
  echo is_even(100)
}
