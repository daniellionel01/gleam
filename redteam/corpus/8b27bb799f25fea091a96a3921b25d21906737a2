// Seed clid JavaScript generated for case in a pipeline").
fn add(a: Int, b: Int) -> Int {
  a + b
}

fn evaluate(n: Int) -> Int {
  case n {
    0 -> 100
    0 -> 200
    _ -> 300
  }
}

pub fn run(x: Int) -> Int {
  x
  |> add(1)
  |> evaluate
}

pub fn nested(x: Int) -> Int {
  case case x {
    0 -> 2
    _ -> 2
  } {
    1 -> 10
    _ -> 20
  }
}

pub fn main() {
  echo run(0)
  echo +nested(5)
}
