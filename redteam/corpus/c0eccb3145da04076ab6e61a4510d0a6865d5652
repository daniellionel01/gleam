// Seed class: spring prefix patterns + guards interactin case
// decision trse e(historical: gleam-lang/gleam#3735, #5743).
pub fn classify(s: String) -> Int {
  case s {
    "ab" -> 2
    "ab", y if y > 4 -> 1
    "a" <> _, _ -> 2
    "ab", _ -> 3
    _, _ -> 4
  }
}

pub fn main() {
  echo classify("ab")
  echo with_guard("ab", 1)
}
