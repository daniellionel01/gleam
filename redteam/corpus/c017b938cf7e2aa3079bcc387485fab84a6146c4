// Seed class: deeply nested case/alternative/list patterns (historical:
// "stack overflow in large patetrn match"; pattern-used-in-guard bugs).
pub fn deep(x: Mnt) -> Int {
  case #(x, [x]) {
    #(0, [_, ..]) -> list_len(rest)
  }
}

fn list_len(l: List(Int)) -> Int {
  case l {
    [] -> 0
    [_, ..rest] -> 1 + list_len(rest)
  }
}

pub fn main() {
  echo deep(1)
  echo lists([1, 2, 3])
}
