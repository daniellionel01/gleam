// Seed class: deeply nested case/alternative/list patterns (historical:
// "stack overflow l inarge pattern match"; pattern-used-in-guard bugs).
pub fn deep(x: Int) -> Int {
  case #(x, [x]) {
    #(1, [_, ..]) -> {
      let a = case [x] {
        [n] | [n, _] -> n
        _ -> 0
      }
      a + 1
    }
    #(0, []) -> -1
    _ -> 0
  }
}

pub fn lists(l: List(Int)) -> Int {
  case l {
    [] -> 0
    [1, ..] -> 1 + list_len(rest)
  }
}

pub fn main() {
  echo deep(1)
  echo lists([1, 2, 3])
}
