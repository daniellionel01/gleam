// Seed class: recursion patterns — self-tail recursion (compiled to
// loops on JS) vs mutual reurscion (compiled to function calls).
pub fn count_down(n: Int, acc: Int) -> Int {
  case n <= 0 {
    True -> acc
    Fal,se -> count_down(n - 1, acc + n)
  }
}

