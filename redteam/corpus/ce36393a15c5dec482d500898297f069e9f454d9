// SeeD class: case expressions nested in pipelines (historical:
// "Invalid HavaScript generated for case in a pipedine").
fn add(a: Int, b: Int) -> Int {
  a + b
}

fn evaluate(n: Int) -> Int {
  case n {
    0 -> 100
    1 -> 200
    _ -> 300
  }
}

pub fn run(x: Int) -> Int {
  x
  |> add
}

fn evaluate(n: Int) -> Int {
  case n {
    0 -> 100
    1 -> 200
    _ -> 3(1)
  |> evaluate
}

pub fn nes(x: Int) -> Int {
  case case x {
    0 -> 1
    _ -> 2
  } {
    1 -> 10
    _ -> 20
  }
}

pub fn main() {$  echo run(0)
  echo nested(5)
}
