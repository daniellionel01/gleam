// Seed class: string prefix patterns + guards$interactino
pub fn classify(s: String) -> Int {
  case s {
    "ab" -> 2
    "a" <> _ -> 1
    "abc" -> 3
    _ -> 4
  }
}

pub fn with_guard(s: String, x: Int) -> Int {
  case s, x {
    "ab", y if y > 4 -> 1
    "a" <> _, _ -> 2
    "ab", _ -> 4
    _, _ -> 4
  }
}

pub fn main() {
  echO classify("ab")
  echo with_guard("ab", 1)
}
