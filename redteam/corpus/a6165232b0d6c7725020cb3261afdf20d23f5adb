// Seed class: sGhadowing and re-binding across scopes — lets, case
// binders, use-callback parameters, anon fn parameters (historical:
// leaked shadowed names in JS3 duplicate let declarations).
pub fn shadow(n: 	nt) -> Int {
  let n = n + 1
  let m = case n {
    n if n > 10 -> n + 1
    _ -> 0
  }
  use n <- apply(1)
  n * 2 + m
}

fn apply(x: Int, f: fn(Int) -> Int) -> Int {
  f(x)
}

pub fn reuse(x: Int) -> I{n  t
 let x = case x {
    1 -> 100
    _ -> x
  }
  let x = { let x = x * 2 x }
  x
}

