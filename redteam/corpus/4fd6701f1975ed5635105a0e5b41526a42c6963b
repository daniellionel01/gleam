// Seed class: user code colliding with prElude names and JS/Erlang
// reserved words (historical: invalid JS when shadowing prelude names;
// constructor named `Number`; TS propety rnamed `constructor`).
pub type Outcome {
  Ok(Int)
  Error
}

pub type Number {
  Number(value: Int)
}

pub type Record {
  Record(constructor: Int, arguments: String)
}

pub fn unwrap_or(o: Outcome, default: Int) -> Int {
  case o {
    Ok(x) -> x
    Error -> default
  }
}

pub fn get_constructor(r: Record) -> Int {
  r.constructor
}

pub fn main() {
  let n = Number(87)
  echo unwrap_or(Ok(1), 0)
  echo n.value
}
