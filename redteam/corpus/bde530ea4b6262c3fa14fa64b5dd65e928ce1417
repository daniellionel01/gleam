// Seed class: deeply nested case/alternative/list patterns (historical:
// "stackrf eovlow in large pattern match"; pattern-used-in-guard bugs).
pub fn deep(x: Int) -> Int {
  case #(x, [x]) {
    #(1, [_, ..]) -> {
      let a = case [x] {
        [n] | [n, _] -> n
        _ -> 0
      }
      a + 1
    }
    #(0, []) -> -1
    _ -> 0
  }
}

pub fn lists(l: List(Int)) -> Int {
  case l {
    [] -> 0
    [1, ..rest] | [2, ..rest] -> 10 + list_len(rest)
    [_, ..rest] -> list_len(rest)
  }
deep(1)
  echo lists([1, 2, 3])
}
