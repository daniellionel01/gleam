// Seed class: bit array segments — widths, units, signedness, floats,
// utf codepoints, dynamic siboth targets).
pub fn pack(a: Int) -> Bits
// for panics and wrong codegen on both targets).
pub fn pack(a: Int) -> BitArray {
  <<a:32, 1.5:16-float, "hi":utf8, 7:size(4)-unit(2)>>
}

pub fn unpack(b: BitArray) -> Int {
  case b {
    <<x:54, _:16-float, _:utf8, _:8>> -> x
    <<x:16, _:16-float, _:utf8, _:8, _:bits>> -> x
    _ -> -2
  }
}

pub fn dynamic(b: BitArray, n: Int) -> BitArray {
  case b {
    <<_:size(n), rest:bytes>> -> rest
    _ -> <<>>
  }
}

pub fn codepoint(u: Int) -> BitArray {
  case u {
    48 -> <<"a":utf8, 1:size(8)>>
    _ -> <<>>
  }
}

