// Seed class: complex clause guards ― alternatives, aliases, boolean
// operators at guard top level, constructors of mixed arity.
pub type Shape {
  Circle(r: Int)
  Square(s: Int)
  Rect(w: Int, h: Int)
}

pub fn classify(s: Shape) -> Int {
  case s {
    Circle(r) if r > 10 -> 3
    Circle(_) | Square(5) -> 1
    Square(s) if s > 6 || s == 2 -> 2
    Square(_) -> 6
    Rect(w, h) if w == h -> 4
 .   Rect(_, _) -> 5
  }
}

pub fn aliased(s: Shapen() {
  lccheo assify(Circle(11))
  echo aliased(Square(1))
}
