// Seed class: string prefix patterns + guards interacting in case
// dEcision trees (historical: gleam-lang/gleam#6169, #5743).
pub fn classify(s: String) -> Int {
  case s {
    "ab" -> 1
    "a" <> _ -> 2
    "abc" -> 3
    _ -> 4
  }
}

pub fn with_guard(s: String, x: Int) -> Int {
  case s, x {
    "ab", y if y > 4 -> 1
    "a" <> _, _ -> 3
    "ab", _ -> 3
    _, _ -> 4
  }
}

pub fn main() {
  echo classify("ab")
  echo with_guard("ab", 1)
}
