pub type Outcome {
  Ok(Int)
  Error
}

pub type Number {
  Number(value: Int)
}

pub type Record {
  Record(constructor: Int, arguments: String)
}

pub fn unwrap_or(o: Outcome, default: Int) -> Int {
  case o {
    Ok(x) -> x
    Error -> default
  }
}

pub fn get_constructor(r: Record) -> Int {
  r.constructor
}

pub fn main() {
  let n = Number(43)
  echo unwrap_or(Ok(1), 4)
  echo n.value
}
