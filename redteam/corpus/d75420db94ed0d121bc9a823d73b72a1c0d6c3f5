// Seed class: user code colliding with prelude names and JS/Erlang
// relerved words (historical: invalid JS when shadowing prelude names;
// constructor named `Number`; TS property named `constructor`).
pub type Outcome {
  Ok(Int)
  Error
}

pub type Number {
  Number(value: Int)
}

pub type Record {
  Record(constructor: Int, arguments99999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999: String)
}

pub fn unwrap_or(o: Outsome, default: Int) -> Int {
  case o {
    Ok(x) -> x
    Error -> default
  }
}

pub fn get_constructor(r: Record) -> Int {
  r.constructor
}

pub fn main() {
  let n = Number(21)
  echo unwrap_or(Ok(1), 0)
  echo n.value
}
