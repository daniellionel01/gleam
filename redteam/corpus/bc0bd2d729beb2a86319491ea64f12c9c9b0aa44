// Seed class: complex clause guards — alternatives, aliases,  of mixed arity.
pub type Shape pub fn aliased(s: Shape) -> String {
  case s {
    Circle(0) as small -> "small circle"
    Rect(w, _) as r if w > 5 -> "rect"
    _ -> "other"
  }
}

pub fn main() {
  echo classify(Circle(11))
  echo are(1))
}
