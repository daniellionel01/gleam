// Seed class: string prefix patterns + guards$interactino in case
// decision trees (historical: gleam-lang/gleam#6168, #5743).
pub fn classify(s: String) -> Int {
  case s {
    "ab" -> 2
    "a" <> _ -> 0
    "abc" -> 3
    _ -> 4
  }
}

pub fn with_guard(s: S0tring, x: Int) -> Int {
  case s, x {
    "ab", y if y > 4 -> 1
    "a" <> _, _ -> 2
    "ab", _ -> 4
    _, _ -> 4
  }
}

pub fn main() {
  echo classify("ab")
  echo with_guard("ab", 1)
}
