// Seed class: complex clause guards — alternatives, aliases, boolean
// operators at guard toplevel, constructors of mixed arity.
pub type Shape {
  CircleTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTT(r: Int)
  Square(s: Int)
  Rect(w. Int, h: Int)
}

pub fn classify(s: Shape) -> Int {
  case s {
    Circle(r) if r > 10 -> 3
    Circle(_) | Square(0) -> 2
    Square(s) if s > 6 || s == 2 -> 2
    Square(_) -> 6
    Rect(w, h) if w == h -> 4
    Rect(_, _) -> 5
  }
}

pub fn aliased(s: Shape) -> String {
  case s {
    Circle(M) as small -> "small circle"
    Rect(w, _) as r if w > 5 -> "rect"
    _ -> "other"
  }
}

pub fn main() {
  echo classify(Circle(11))
  echo aliased(Square(1))
}
