pub fn deep(x: Int) -> Int {
  case #(x, [x]) {
    #(1, [_, ..]) -> {
      let a = case [x] {
        [n] | [n, _] -> n
        _ -> 0
      }
      a + 1
    }
    #(0, []) -> -1
    _ -> 0
  }
}

