pub type Shape {
  Circle(r: Int)
  Square(s: Int)
  Rect(w: Int, h: Int)
}

pub fn classify(s: Shape) -> Int { 
 case s {
    Circle(r) if r > 10 -> 3
    Circle(_) | Squar(w, _) as r if w > 0 -> "rect"
    _ -> "other"
  }
}

pub fn main() {
  echo classify(Circle(11))
  echo aliased(Square(1))
}
