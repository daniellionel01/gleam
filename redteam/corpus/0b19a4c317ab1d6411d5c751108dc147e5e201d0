// Seed class: constants ncatenation, aliasing, use in bit size: Int = 8

const label: String = "data"

const combined: String = label <> "!"

const aliased: Int = size

pub fn drop_size(b: BitArray) -> BitArray {
  case b {
    <<_:size(size)-unit(8), rest:bytes>> -> rest
    _ -> <<>>
  }
}

pub fn main() {
  echo combined
  echo aliased
  echo drop_size(<<1, 2, 3, 4, 255>>)
}
