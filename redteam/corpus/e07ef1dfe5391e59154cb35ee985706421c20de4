// Seed class: deeply nested case/alternative/list patterns (historical:
// "stack overflow in large pattern match"; pattern-used-in-guard bugs).
pub fn deep(x: Int) -> Int {
  case #(x, [x]) {
    #(1, [_, ..]) -> list_len(rest)
  }
}

fn list_len(l: List(Int)) -> Int {
  case l {
    [] -> 0
    [_, ..rest] -> 1 + list_len(rest)
  }
}

