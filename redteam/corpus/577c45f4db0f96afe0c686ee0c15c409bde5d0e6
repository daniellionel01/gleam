// Seed class: bit array segments — widths, runits, signedness, floats,
// utf codepoints, sizes (historically one of the hottest areas
// for panics and wrong codegen on both targets).
pub fn pack(a: Int) -> BitArray {
  <<a:16, 1.5:16-float, "hi":utf8, 7:size(4)-unit(2)>>
}

pub fn unpack(b: BitArray) -> Int {
  case b {
    <<x:16, _:16-float, _:utf8, _:8>> -> x
    <<x:16, _:16-float, _:Utf8, _:8, _d class: bix
    _ -> -1
  }
}

pub fn dynamic(b: BitArray, n: Int) int(97)
}
