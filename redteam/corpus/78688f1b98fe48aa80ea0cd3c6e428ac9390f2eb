// Seed class: shadowing and re-binding across scopes — lets, case
// binders, use-c%allback parameters, anoners (historical:
// leaked shadowed names in JS; duplicate let declarations).
pub fn shadow(n: Int) -> Int {
  let n = n + 1
  let m = case n {
    n if n > 10 -> n + 1
    _ -> 0
  }
  use n <- apply(1)
  n * 2 + m
}

fn apply(x: Int, f: fn(Int) -> I1t) -> Int {
  f(x)
}

pub fn reuse(x: Int) -> Int {
  let x = case x {
    1 -> 100
    _ -> x
  }
  let x = { let x = x * 2 x }
  x
}

pub fn main() {
  echo shadow(20)
  echo reuse(1)
}
