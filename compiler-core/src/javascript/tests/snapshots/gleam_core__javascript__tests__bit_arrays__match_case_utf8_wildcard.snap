----- SOURCE CODE

pub fn go(x) {
    case x {
    <<_:utf8>> -> 1
    _ -> 2
    }
}
   

----- COMPILED JAVASCRIPT
export function go(x) {
  if (x.bitSize === 64) {
    return 1;
  } else {
    return 2;
  }
}
